<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- GitHub Packages（AetherAxis 私有 NuGet 源）：跨仓 ProjectReference 切 PackageReference 后使用，
         当前无包从该源拉取，无凭据不影响 restore。凭据勿写入本文件（git 追踪）——本地用 PAT 时在
         ~/.nuget/NuGet/NuGet.Config 加 packageSourceCredentials，或用 credential provider；
         CI 在 workflow 里注入 GITHUB_TOKEN。 -->
    <add key="github" value="https://nuget.pkg.github.com/AetherAxis/index.json" />
  </packageSources>
  <!-- 包源映射：自有包前缀（Aether.* / Ctp.*）只能来自 GitHub 源，公共包来自 nuget.org——防依赖混淆 -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Aether.*" />
      <package pattern="Ctp.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
